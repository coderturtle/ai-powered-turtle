{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDD Intent Contract",
  "type": "object",
  "required": [
    "id",
    "title",
    "outcome",
    "scope",
    "non_goals",
    "constraints",
    "acceptance",
    "context",
    "evidence",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "outcome": {
      "type": "object",
      "required": [
        "statement"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "rationale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "systems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "architecture": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "standards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "security": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "regulatory": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "statement": {
            "type": "string"
          },
          "verification": {
            "type": "string",
            "enum": [
              "unit-test",
              "integration-test",
              "behavioural-test",
              "architecture-rule",
              "security-scan",
              "static-analysis",
              "manual-review",
              "runtime-observation",
              "documented-evidence"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "context": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "READY",
        "PLANNED",
        "IN_PROGRESS",
        "VERIFYING",
        "COMPLETE",
        "BLOCKED",
        "SUPERSEDED"
      ]
    }
  },
  "additionalProperties": false
}
